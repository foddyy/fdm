<?xml version="1.0" encoding="utf-8"?>
<!-- Main Activity layout - Horizontal mode -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#F5F7FA"
    android:padding="12dp">

    <!-- Left side: Distance display -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="爱眼"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2D3748"
            android:layout_marginBottom="12dp" />

        <!-- Distance display box -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="12dp"
            android:background="@drawable/box_rounded_light">

            <TextView
                android:id="@+id/tv_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="35"
                android:textSize="56sp"
                android:textStyle="bold"
                android:textColor="#319795" />

            <TextView
                android:id="@+id/tv_distance_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:text="实时距离"
                android:textSize="12sp"
                android:textColor="#718096" />

            <TextView
                android:id="@+id/tv_distance_recommendation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:text="建议35cm，不小于30cm"
                android:textSize="10sp"
                android:textColor="#718096" />

        </FrameLayout>

        <!-- Feedback button -->
        <Button
            android:id="@+id/btn_feedback_tip"
            android:layout_width="140dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:text="反馈/打赏"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#319795"
            android:background="@drawable/btn_background_light"
            android:padding="0dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:minHeight="40dp" />

    </LinearLayout>

    <!-- Right side: Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp">

        <!-- Language toggle -->
        <Button
            android:id="@+id/btn_language"
            android:layout_width="50dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginStart="8dp"
            android:text="EN"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#319795"
            android:background="@drawable/btn_background_light"
            android:padding="0dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:minHeight="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp" />

        <!-- Start/Pause button -->
        <Button
            android:id="@+id/btn_start_pause"
            android:layout_width="120dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:text="开始监控"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#319795"
            android:background="@drawable/btn_background_light"
            android:padding="0dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:minHeight="120dp" />

        <!-- Calibrate button -->
        <Button
            android:id="@+id/btn_calibrate"
            android:layout_width="120dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:text="校准"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#319795"
            android:background="@drawable/btn_background_light"
            android:padding="0dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:minHeight="120dp" />

    </LinearLayout>

</LinearLayout>