<?xml version="1.0" encoding="utf-8"?>
<!-- Main Activity layout - simplified design -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: title + language toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_app_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="爱眼"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#2D3748" />

            <Button
                android:id="@+id/btn_language"
                android:layout_width="60dp"
                android:layout_height="28dp"
                android:text="EN"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#319795"
                android:backgroundTint="#E6FFFA"
                android:padding="0dp" />

        </LinearLayout>

        <!-- Distance display box -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/box_rounded_light">

            <TextView
                android:id="@+id/tv_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="35"
                android:textSize="64sp"
                android:textStyle="bold"
                android:textColor="#319795" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="16dp"
                android:text="实时距离"
                android:textSize="14sp"
                android:textColor="#718096" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:text="建议35cm，不小于30cm"
                android:textSize="12sp"
                android:textColor="#718096" />

        </FrameLayout>

        <!-- Two buttons: start/pause and calibrate -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btn_start_pause"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="开始监控"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#319795"
                android:elevation="4dp"
                android:layout_elevation="4dp" />

            <Button
                android:id="@+id/btn_calibrate"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="重新校准"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#319795"
                android:backgroundTint="#E6FFFA"
                android:elevation="4dp"
                android:layout_elevation="4dp" />

        </LinearLayout>

        <!-- Bottom button: feedback/tip -->
        <Button
            android:id="@+id/btn_feedback_tip"
            android:layout_width="215dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:text="反馈/打赏"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#319795"
            android:elevation="4dp"
            android:layout_elevation="4dp"
            android:layout_marginBottom="32dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
