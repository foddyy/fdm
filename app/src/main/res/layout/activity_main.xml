<?xml version="1.0" encoding="utf-8"?>
<!-- Main Activity layout - 5 card design -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <!-- Card 1: Header (icon + title + language toggle) -->
        <include
            android:id="@+id/card_header_layout"
            layout="@layout/card_header" />

        <!-- Card 2: Status display (frosted glass) -->
        <include
            android:id="@+id/card_status_layout"
            layout="@layout/card_status" />

        <!-- Card 3: Distance & threshold -->
        <include
            android:id="@+id/card_distance_layout"
            layout="@layout/card_distance" />

        <!-- Card 4: Buttons (frosted glass) -->
        <include
            android:id="@+id/card_buttons_layout"
            layout="@layout/card_buttons" />

        <!-- Card 5: Tip QR code -->
        <include
            android:id="@+id/card_tip_layout"
            layout="@layout/card_tip" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
