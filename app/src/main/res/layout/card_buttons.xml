<?xml version="1.0" encoding="utf-8"?>
<!-- Card 4: Buttons - frosted glass effect -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="12dp"
    android:background="@drawable/card_frosted">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center">

        <!-- Start/Pause Button -->
        <Button
            android:id="@+id/btn_start_pause"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_start"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#319795" />

        <!-- Calibrate Button -->
        <Button
            android:id="@+id/btn_calibrate"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/btn_calibrate"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#319795"
            android:backgroundTint="#E6FFFA" />

    </LinearLayout>

</FrameLayout>
